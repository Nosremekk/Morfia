<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="content-area"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ffmpegstudio.ui.controller.QueueController">

    <VBox spacing="16">
        <!-- Header -->
        <VBox styleClass="view-header" spacing="4">
            <Label text="Fila de Processamento em Lote" styleClass="view-title"/>
            <Label text="Gerencie, reordene e execute tarefas multimídia em segundo plano com limite configurável de paralelismo."
                   styleClass="view-subtitle"/>
        </VBox>

        <VBox spacing="16" styleClass="view-body">

            <!-- Toolbar Card -->
            <VBox styleClass="card" spacing="14">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button fx:id="btnAddBatch" text="Adicionar Arquivos em Lote..." onAction="#handleAddBatchFiles" styleClass="button-primary"/>
                    <VBox spacing="2">
                        <Label text="Preset para novos itens:" styleClass="text-muted" style="-fx-font-size: 10px;"/>
                        <ComboBox fx:id="cmbBatchPreset" prefWidth="240"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="btnStartPause" text="Iniciar Fila" onAction="#handleToggleStartPause" styleClass="button-success"/>
                    <Button fx:id="btnClearFinished" text="Limpar Concluídas" onAction="#handleClearFinished" styleClass="button-outline"/>
                    <Button fx:id="btnCancelAll" text="Cancelar Tudo" onAction="#handleCancelAll" styleClass="button-danger"/>
                </HBox>

                <!-- Aggregate Progress Bar -->
                <VBox spacing="6">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Progresso Geral:" styleClass="text-secondary"/>
                        <Label fx:id="lblSummaryStatus" text="Fila vazia." styleClass="text-primary"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblProgressPercent" text="0%" styleClass="badge, badge-info"/>
                    </HBox>
                    <ProgressBar fx:id="progressAggregate" maxWidth="Infinity" progress="0.0"/>
                </VBox>
            </VBox>

            <!-- Queue Jobs List -->
            <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Tarefas na Fila" styleClass="card-title"/>
                    <Label fx:id="lblJobsCount" text="0 tarefas" styleClass="badge, badge-neutral"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Reordene tarefas pendentes usando as ações de cada item" styleClass="text-muted"/>
                </HBox>

                <ListView fx:id="lvQueueJobs" prefHeight="420" styleClass="list-view"/>
            </VBox>

        </VBox>
    </VBox>
</ScrollPane>
