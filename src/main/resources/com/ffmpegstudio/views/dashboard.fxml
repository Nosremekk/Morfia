<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ffmpegstudio.ui.controller.DashboardController">

    <VBox spacing="24">
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" styleClass="view-header">
            <VBox spacing="4">
                <Label text="Dashboard" styleClass="view-title"/>
                <Label text="Overview of local FFmpeg capabilities and quick batch import" styleClass="view-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <ProgressIndicator fx:id="loadingSpinner" prefWidth="20" prefHeight="20"/>
                <Button fx:id="btnRefresh" text="Refresh Engine" onAction="#refresh" styleClass="button-outline"/>
                <Button fx:id="btnOpenSettings" text="Settings" onAction="#onOpenSettings" styleClass="button"/>
            </HBox>
        </HBox>

        <!-- Body -->
        <VBox spacing="20" styleClass="view-body">

            <!-- System Readiness Banner -->
            <VBox fx:id="bannerContainer" styleClass="banner, banner-ready" spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblBannerTitle" text="FFmpeg Engine Ready" styleClass="card-title"/>
                        <Label fx:id="lblBannerSubtitle" text="Inspecting system capabilities..." styleClass="card-subtitle"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Stats Overview Cards -->
            <HBox fx:id="statsBox" spacing="16">
                <!-- Video Encoders -->
                <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="VIDEO ENCODERS" styleClass="card-stat-label"/>
                    <Label fx:id="lblVideoEncoders" text="-" styleClass="card-stat-value"/>
                    <Label text="Available for transcoding" styleClass="text-muted"/>
                </VBox>

                <!-- Audio Encoders -->
                <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="AUDIO ENCODERS" styleClass="card-stat-label"/>
                    <Label fx:id="lblAudioEncoders" text="-" styleClass="card-stat-value"/>
                    <Label text="Supported audio codecs" styleClass="text-muted"/>
                </VBox>

                <!-- Hardware Accels -->
                <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="HW ACCELERATION" styleClass="card-stat-label"/>
                    <Label fx:id="lblHwAccels" text="-" styleClass="card-stat-value"/>
                    <Label fx:id="lblHwList" text="Inspecting..." styleClass="text-muted" wrapText="true"/>
                </VBox>

                <!-- Filters -->
                <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="AV FILTERS" styleClass="card-stat-label"/>
                    <Label fx:id="lblFilters" text="-" styleClass="card-stat-value"/>
                    <Label text="Video/audio transform filters" styleClass="text-muted"/>
                </VBox>
            </HBox>

            <!-- Media Import Drop Zone -->
            <VBox fx:id="dropZone" styleClass="dropzone" spacing="12">
                <VBox alignment="CENTER" spacing="4">
                    <Label text="Drop media files here to start" styleClass="dropzone-title"/>
                    <Label text="Supports MP4, MKV, WebM, MOV, MP3, FLAC, WAV, GIF, and all FFmpeg formats" styleClass="dropzone-subtitle"/>
                </VBox>
                <HBox alignment="CENTER">
                    <Button fx:id="btnBrowseFiles" text="Browse Files..." styleClass="button-primary" onAction="#onBrowseFiles"/>
                </HBox>
            </VBox>

        </VBox>
    </VBox>
</ScrollPane>
