<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ffmpegstudio.ui.controller.MainLayoutController"
            prefHeight="720.0" prefWidth="1100.0">

    <!-- Left Sidebar -->
    <left>
        <VBox spacing="16" styleClass="sidebar">
            <!-- Brand -->
            <HBox fx:id="brandBox" alignment="CENTER_LEFT" spacing="10">
                <padding>
                    <Insets bottom="12" left="6" right="6" top="6"/>
                </padding>
                <VBox spacing="2">
                    <Label text="Morfia" styleClass="brand-title"/>
                    <Label text="MULTIMEDIA PROCESSING STUDIO" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>

            <!-- Navigation Links -->
            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <Button fx:id="btnNavDashboard"
                        text="Dashboard"
                        maxWidth="Infinity"
                        styleClass="nav-button"
                        onAction="#showDashboard"/>

                <Button fx:id="btnNavWorkspace"
                        text="Biblioteca"
                        maxWidth="Infinity"
                        styleClass="nav-button"
                        onAction="#showWorkspace"/>

                <Button fx:id="btnNavConverter"
                        text="Converter"
                        maxWidth="Infinity"
                        styleClass="nav-button"
                        onAction="#showConverter"/>

                <Button fx:id="btnNavCompression"
                        text="Compressão"
                        maxWidth="Infinity"
                        styleClass="nav-button"
                        onAction="#showCompression"/>

                <Button fx:id="btnNavTools"
                        text="Ferramentas"
                        maxWidth="Infinity"
                        styleClass="nav-button"
                        onAction="#showTools"/>

                <Button fx:id="btnNavConcat"
                        text="Concatenação"
                        maxWidth="Infinity"
                        styleClass="nav-button"
                        onAction="#showConcat"/>

                <Button fx:id="btnNavSubtitles"
                        text="Legendas"
                        maxWidth="Infinity"
                        styleClass="nav-button"
                        onAction="#showSubtitles"/>

                <Button fx:id="btnNavFilters"
                        text="Filtros"
                        maxWidth="Infinity"
                        styleClass="nav-button"
                        onAction="#showFilters"/>

                <Button fx:id="btnNavStreams"
                        text="Streams &amp; Metadados"
                        maxWidth="Infinity"
                        styleClass="nav-button"
                        onAction="#showStreams"/>

                <Button fx:id="btnNavQueue"
                        text="Fila de Tarefas"
                        maxWidth="Infinity"
                        styleClass="nav-button"
                        onAction="#showQueue"/>

                <Button fx:id="btnNavHistory"
                        text="Histórico"
                        maxWidth="Infinity"
                        styleClass="nav-button"
                        onAction="#showHistory"/>

                <Button fx:id="btnNavSettings"
                        text="Configurações"
                        maxWidth="Infinity"
                        styleClass="nav-button"
                        onAction="#showSettings"/>

                <Button fx:id="btnNavSetupWizard"
                        text="Assistente FFmpeg"
                        maxWidth="Infinity"
                        styleClass="nav-button"
                        onAction="#showSetupWizard"/>
            </VBox>

            <!-- Status Indicator Footer -->
            <VBox styleClass="status-footer" spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Circle fx:id="statusDot" radius="4" styleClass="status-dot, dot-warning"/>
                    <Label text="ENGINE" styleClass="text-muted" style="-fx-font-size: 10px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblVersionBadge" text="v8.1.3" styleClass="badge"/>
                </HBox>
                <Label fx:id="lblStatusText"
                       text="Initializing FFmpeg engine..."
                       styleClass="text-secondary"
                       style="-fx-font-size: 11px;"
                       wrapText="true"/>
            </VBox>
        </VBox>
    </left>

    <!-- Center Content -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>

</BorderPane>
